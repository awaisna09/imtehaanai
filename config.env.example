# =============================================================================
# PRODUCTION-GRADE ENVIRONMENT CONFIGURATION
# =============================================================================
# This configuration is structured for a Redis-first, async architecture where:
# - All AI workloads run asynchronously in background workers
# - API layer only handles auth, validation, and job enqueueing
# - Database stability is prioritized through batching and caching
# - Back-pressure mechanisms prevent system overload
# =============================================================================

# =============================================================================
# REQUIRED: CORE INFRASTRUCTURE
# =============================================================================
# These values must be set for the system to function. No safe defaults exist.

# OpenAI API Key (REQUIRED)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Database Configuration (REQUIRED)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# IMPORTANT: Use separate projects for development/staging/production
# The system will BLOCK dev/staging from using production Supabase URLs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Optional: Service role key for admin operations (higher privileges)
# Only use in secure environments, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=

# Safety Guardrail: Prevent dev/staging from using production Supabase
# Set to true ONLY in emergency situations (NOT RECOMMENDED)
# Default: false (blocks production Supabase in non-production environments)
ALLOW_PROD_SUPABASE_IN_DEV=false

# Redis Configuration (REQUIRED for async job processing)
# For production: Use REDIS_URL (e.g., redis://user:password@host:port/db)
# For development: Use separate host/port/password
# Redis is critical for job queue, rate limiting, and caching
REDIS_URL=
REDIS_HOST=  # Leave empty, use REDIS_URL instead (Railway provides this)
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Connection Retry Configuration (Worker Resilience)
# Workers will automatically retry Redis connections with exponential backoff
# Workers never exit due to Redis unavailability - they wait and retry
REDIS_RETRY_BASE_DELAY=2.0          # Base retry delay in seconds (exponential backoff)
REDIS_RETRY_MAX_DELAY=60.0          # Maximum retry delay in seconds (caps exponential growth)
REDIS_RETRY_MAX_ATTEMPTS=0          # Max retry attempts (0 = infinite retries, recommended)
REDIS_HEALTH_CHECK_INTERVAL=10      # How often to check Redis health during normal operation (seconds)

# =============================================================================
# ENVIRONMENT IDENTIFICATION
# =============================================================================
# Controls behavior, defaults, and safety mechanisms across the system.
# Values: development, staging, production

ENVIRONMENT=development

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
# FastAPI server binding and behavior settings

# Server binding
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# PRODUCTION-GRADE UVICORN CONFIGURATION
# =============================================================================
# Prevents overload and memory spikes under burst traffic

# Timeout Keep Alive: Time to keep idle connections open (seconds)
# Production: 30 (prevents connection buildup, closes idle connections)
# Lower values close connections faster (less memory, more overhead)
UVICORN_TIMEOUT_KEEP_ALIVE=30

# Timeout Graceful Shutdown: Time to wait for graceful shutdown (seconds)
# Production: 10 (fast shutdown, prevents hung processes)
# Lower values shutdown faster but may interrupt active requests
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=10

# Limit Concurrency: Maximum concurrent connections
# Production: 1000 (prevents connection exhaustion)
# Lower values provide stronger protection but may reject legitimate traffic
# Higher values allow more connections but risk resource exhaustion
UVICORN_LIMIT_CONCURRENCY=1000

# Backlog: Connection queue size
# Production: 2048 (connection backlog protection)
# Lower values may drop connections under burst
# Higher values allow more queued connections
UVICORN_BACKLOG=2048

# Workers: Number of uvicorn worker processes
# Production: 1 (PM2/Docker manages instances, do not increase)
# Railway/Docker manage process instances, so keep at 1
UVICORN_WORKERS=1

# Request Timeout: Maximum wait time for Redis/DB operations (seconds)
# Production: 5 (ensures backend never waits longer than this)
# Prevents hung requests from accumulating
REQUEST_TIMEOUT=5

# =============================================================================
# LOAD SHEDDING CONFIGURATION
# =============================================================================
# Prevents system overload by rejecting requests when system is under pressure

# Load Shedding Enabled: Enable load shedding (boolean)
# Production: true (rejects requests when system under pressure)
LOAD_SHEDDING_ENABLED=true

# Load Shedding Queue Threshold: Queue capacity threshold for rejection (0.0-1.0)
# Production: 0.9 (90% capacity) - rejects requests when queue is 90% full
# Lower values reject earlier (stronger protection, more rejections)
# Higher values reject later (weaker protection, fewer rejections)
LOAD_SHEDDING_QUEUE_THRESHOLD=0.9

# Load Shedding Worker Degraded Threshold: Minimum healthy workers required
# Production: 2 (rejects requests if < 2 healthy workers)
# Lower values allow requests with fewer workers (risk of queue buildup)
# Higher values require more workers (stronger protection, more rejections)
LOAD_SHEDDING_WORKER_DEGRADED_THRESHOLD=2

# =============================================================================
# SYSTEM SAFETY GATE CONFIGURATION
# =============================================================================
# Centralized safety checks that prevent work from being enqueued when system is unsafe
# This is the SINGLE SOURCE OF TRUTH for system safety - impossible to bypass

# Safety Gate Enabled: Enable safety gate (boolean)
# Production: true (enforces safety checks before job enqueueing)
# If false, safety checks are skipped (NOT RECOMMENDED)
SAFETY_GATE_ENABLED=true

# Safety Gate Queue Threshold: Queue capacity threshold for rejection (0.0-1.0)
# Production: 0.9 (90% capacity) - rejects work when queue is 90% full
# Lower values reject earlier (stronger protection, more rejections)
# Higher values reject later (weaker protection, fewer rejections)
SAFETY_GATE_QUEUE_THRESHOLD=0.9

# Safety Gate Memory Threshold: Process memory threshold in MB
# Production: 400 (400MB for backend) - rejects work if process memory exceeds this
# Lower values reject earlier (stronger protection, more rejections)
# Higher values reject later (weaker protection, fewer rejections)
# Railway Free Tier: 512MB total, so 400MB is safe
SAFETY_GATE_MEMORY_THRESHOLD_MB=400

# Safety Gate Memory Percent Threshold: System memory percent threshold
# Production: 80 (80% system memory) - rejects work if system memory > 80%
# Lower values reject earlier (stronger protection, more rejections)
# Higher values reject later (weaker protection, fewer rejections)
SAFETY_GATE_MEMORY_PERCENT_THRESHOLD=80

# Safety Gate Min Healthy Workers: Minimum healthy workers required
# Production: 2 (rejects work if < 2 healthy workers)
# Lower values allow work with fewer workers (risk of queue buildup)
# Higher values require more workers (stronger protection, more rejections)
SAFETY_GATE_MIN_HEALTHY_WORKERS=2

# CORS Configuration
# Production: Specify exact origins (e.g., https://imtehaanai.netlify.app)
# Development: Can use * for local development only
# NEVER use * in production - security risk
# Your Netlify frontend: https://imtehaanai.netlify.app/
ALLOWED_ORIGINS=https://imtehaanai.netlify.app,https://imtehaanai.netlify.app/*
ALLOW_CREDENTIALS=true

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# Controls which models are used for different AI workloads.
# These execute asynchronously in workers, so model choice affects throughput,
# not API response time.

# Tutor Agent Model Configuration
TUTOR_MODEL=gpt-4o-mini
TUTOR_TEMPERATURE=1.0
TUTOR_MAX_TOKENS=2000

# Answer Grading Agent Model Configuration
GRADING_MODEL=gpt-4o-mini
GRADING_TEMPERATURE=0.1
GRADING_MAX_TOKENS=2000

# Helping Agent Model Configuration (concept explanations)
HELPING_MODEL=gpt-4o-mini
HELPING_TEMPERATURE=0.3
HELPING_MAX_TOKENS=150

# Helping Agent Model Selection (intelligent routing)
# Enable model selection to route simple queries to faster models
# Production: true (reduces cost and latency for simple queries)
HELPING_ENABLE_MODEL_SELECTION=true

# Fast Model for Simple Queries (lower cost, faster)
# Used for short, definition-based queries identified by query classifier
# Production: gpt-3.5-turbo (faster and cheaper for simple queries)
HELPING_FAST_MODEL=gpt-3.5-turbo

# Minimum Confidence for Fast Model Routing
# Only route to fast model if query classification confidence >= this threshold
# Production: 0.7 (70% confidence - conservative to maintain quality)
# Lower values route more queries to fast model (more cost savings, slight quality risk)
# Higher values route fewer queries to fast model (less cost savings, higher quality)
HELPING_MIN_CONFIDENCE_FAST=0.7

# =============================================================================
# OBSERVABILITY AND LOGGING
# =============================================================================
# Controls system observability, structured logging, and debugging

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Production: INFO or WARNING (DEBUG is too verbose)
# Development: DEBUG or INFO
LOG_LEVEL=INFO

# Log Format: json (structured, production) or text (human-readable, development)
LOG_FORMAT=json

# Enable Debug Mode (boolean)
# Production: false (disables verbose output, improves performance)
# Development: true (enables detailed error messages, stack traces)
ENABLE_DEBUG=false

# LangSmith Tracing Configuration (Optional)
# Enables AI model call tracing and monitoring via LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=imtehaan-ai-tutor
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# REDIS-BACKED JOB QUEUE CONFIGURATION
# =============================================================================
# Controls how jobs are queued, retried, and managed in Redis.
# These settings are critical for async AI workload execution.

# Job Result Retention
# How long completed/failed job results are kept in Redis (seconds)
# Production: 86400 (24 hours) - allows clients to check status
# Lower values reduce Redis memory usage but limit status checking window
JOB_RESULT_TTL=86400

# Job Retry Configuration
# Maximum number of automatic retries for failed jobs
# Production: 3 (balances resilience vs resource usage)
# Higher values increase system resilience but may mask persistent issues
MAX_RETRIES=3

# Retry Delay: Exponential backoff base delay (seconds)
# Production: 60 (1 minute) - prevents immediate retry storms
# Workers implement exponential backoff: delay = RETRY_DELAY * (2 ^ retry_count)
RETRY_DELAY=60

# Retry Exponential Backoff: Enable exponential backoff for retries (boolean)
# Production: true (conservative retry spacing)
# Exponential backoff: delay = RETRY_DELAY * (2 ^ retry_count), capped at MAX_RETRY_DELAY
RETRY_EXPONENTIAL_BACKOFF=true

# Maximum Retry Delay: Cap for exponential backoff (seconds)
# Production: 600 (10 minutes) - prevents extremely long retry delays
# Conservative limit to prevent indefinite retry spacing
MAX_RETRY_DELAY=600

# Job Timeout: Maximum time a job can run before being marked as timeout (seconds)
# Production: 3600 (1 hour) - prevents hung jobs from consuming resources
# Should exceed longest expected AI operation, but not be unbounded
JOB_TIMEOUT=3600

# Job Timeout Per Job Type: Override JOB_TIMEOUT for specific job types (seconds)
# These take precedence over the global JOB_TIMEOUT when specified in job payload
# Production: 300 (5 minutes) for tutor chat - allows 11-node LangGraph pipeline to complete
# Tutor chat jobs have 11 sequential nodes and may need 30-90s under normal load, but can exceed 180s under load
JOB_TIMEOUT_TUTOR_CHAT=300

# Job Timeout Warning: Threshold for slow job warning (seconds)
# Production: 1800 (30 minutes) - warn before timeout to aid debugging
# Jobs exceeding this threshold are logged with warning (even if they complete)
JOB_TIMEOUT_WARNING=1800

# Strict Timeout Enforcement: Enforce job timeouts strictly (boolean)
# Production: true (jobs are cancelled and marked as timeout if they exceed JOB_TIMEOUT)
# If false, jobs can exceed timeout but warnings are logged
STRICT_TIMEOUT_ENFORCEMENT=true

# Idempotency Configuration
# Prevents duplicate job processing for same request within window
ENABLE_IDEMPOTENCY=true
IDEMPOTENCY_WINDOW=3600

# =============================================================================
# BACK-PRESSURE MECHANISMS
# =============================================================================
# Prevents queue overflow and system overload under sustained load

# Maximum Queue Size: Maximum pending jobs per queue
# Production: 5000-10000 (balances throughput vs memory usage)
# Lower values provide stronger back-pressure but may reject legitimate traffic
# Higher values allow more queuing but risk Redis memory exhaustion
MAX_QUEUE_SIZE=10000

# Queue Full Policy: Behavior when queue is full
# Values: reject (return 503, recommended), drop_oldest (remove oldest job)
# Production: reject (protects system, signals clients to retry)
# NEVER use 'wait' in API layer - would block HTTP requests
QUEUE_FULL_POLICY=reject

# Queue Back-Pressure Threshold: Queue capacity threshold for back-pressure (0.0-1.0)
# Production: 0.8 (80% capacity) - triggers back-pressure before queue is full
# When queue depth >= MAX_QUEUE_SIZE * threshold, workers apply delays
QUEUE_BACK_PRESSURE_THRESHOLD=0.8

# Queue Back-Pressure Delay: Delay when back-pressure threshold is reached (seconds)
# Production: 1.0 (1 second) - gives system time to catch up
# Workers delay dequeuing when queue is under back-pressure
QUEUE_BACK_PRESSURE_DELAY=1.0

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================
# Controls background worker processes that execute AI workloads.
# These settings balance throughput, resource usage, and database stability.

# Worker Concurrency: Maximum concurrent jobs per worker process
# UPDATED: Increased default to 3 for better throughput (2-4 range recommended)
# Higher values increase throughput but risk database connection exhaustion
# Must be <= MAX_DB_CONNECTIONS to prevent connection pool exhaustion
WORKER_CONCURRENCY=3

# Database Connection Pool Size: Maximum concurrent database connections per worker
# UPDATED: Increased default to 5 to support higher concurrency
# Must exceed WORKER_CONCURRENCY to handle job variations
# Each concurrent job may need 1-2 database connections (read + write)
MAX_DB_CONNECTIONS=5

# =============================================================================
# DATABASE LOAD SAFETY: OPERATION TIMEOUTS & RETRIES
# =============================================================================
# Timeout and retry configuration for database operations
# Provides resilience to transient errors and prevents hanging queries

# DB Operation Timeout: Maximum time for a DB operation (seconds)
# Production: 30.0 (prevents hanging queries from consuming resources)
# Should exceed longest expected query but not be unbounded
# Lower values fail faster but may interrupt legitimate long queries
DB_OPERATION_TIMEOUT=30.0

# DB Max Retries: Maximum retry attempts for transient errors
# Production: 3 (balances resilience vs resource usage)
# Retries use exponential backoff with jitter
# Higher values increase resilience but may mask persistent issues
DB_MAX_RETRIES=3

# DB Retry Base Delay: Base delay for exponential backoff (seconds)
# Production: 1.0 (1 second base delay)
# Exponential backoff: delay = base * (2 ^ retry_count), capped at max delay
# Lower values retry faster but may overwhelm recovering systems
DB_RETRY_BASE_DELAY=1.0

# DB Retry Max Delay: Maximum retry delay cap (seconds)
# Production: 10.0 (10 seconds max delay)
# Prevents extremely long retry delays
# Lower values retry more frequently but may overwhelm systems
DB_RETRY_MAX_DELAY=10.0

# =============================================================================
# DATABASE LOAD SAFETY: QUERY PAGINATION
# =============================================================================
# Enforces pagination and explicit column selection for all queries
# Prevents large result sets and SELECT * anti-patterns

# DB Max Page Size: Default maximum page size for paginated queries
# Production: 50 (prevents large result sets from overwhelming network/DB)
# Lower values reduce payload size but may require more requests
# Higher values allow larger result sets but increase memory/network usage
DB_MAX_PAGE_SIZE=50

# DB Absolute Max Page Size: Hard limit on page size (cannot be exceeded)
# Production: 1000 (absolute maximum, prevents abuse)
# This is a hard cap - queries requesting larger pages will be capped at this value
# Lower values provide stronger protection but may limit legitimate use cases
DB_ABSOLUTE_MAX_PAGE_SIZE=1000

# =============================================================================
# DATABASE LOAD SAFETY: WORKER THROTTLING & BACKPRESSURE
# =============================================================================
# Worker throttling prevents overload and provides backpressure mechanisms
# Protects database from error cascades and excessive load

# Worker Max Jobs Per Loop: Maximum jobs to pull per worker loop iteration
# Production: 1 (prevents pulling too many jobs at once)
# Lower values provide stronger throttling but may reduce throughput
# Higher values allow more jobs per loop but risk overload
WORKER_MAX_JOBS_PER_LOOP=1

# Worker DB Error Threshold: DB errors in 60s window to trigger pause
# Production: 5 (triggers circuit breaker after 5 errors in 60 seconds)
# Lower values trigger pause sooner (more protective, less throughput)
# Higher values allow more errors before pausing (less protective, more throughput)
WORKER_DB_ERROR_THRESHOLD=5

# Worker DB Error Pause Min: Minimum pause duration when threshold exceeded (seconds)
# Production: 30 (30 seconds minimum pause)
# Lower values resume faster but may not allow system to recover
# Higher values allow more recovery time but reduce throughput
WORKER_DB_ERROR_PAUSE_MIN=30

# Worker DB Error Pause Max: Maximum pause duration when threshold exceeded (seconds)
# Production: 60 (60 seconds maximum pause)
# Random pause duration between min and max prevents thundering herd
# Lower values resume faster but may not allow system to recover
# Higher values allow more recovery time but reduce throughput
WORKER_DB_ERROR_PAUSE_MAX=60

# =============================================================================
# DATABASE LOAD SAFETY: PER-JOB-TYPE RATE LIMITS
# =============================================================================
# Per-job-type rate limits prevent specific job types from overwhelming system
# Limits are enforced per worker (jobs per minute, 0 = no limit)

# Worker Rate Limit: Grading Jobs (jobs per minute)
# Production: 10 (max 10 grading jobs per minute per worker)
# Prevents grading job spam from overwhelming database
# Set to 0 to disable rate limiting for this job type
WORKER_RATE_LIMIT_GRADING=10

# Worker Rate Limit: Analytics Jobs (jobs per minute)
# Production: 5 (max 5 analytics jobs per minute per worker)
# Analytics jobs can be resource-intensive, so limit is conservative
# Set to 0 to disable rate limiting for this job type
WORKER_RATE_LIMIT_ANALYTICS=5

# Worker Rate Limit: Generation Jobs (jobs per minute)
# Production: 3 (max 3 generation jobs per minute per worker)
# Generation jobs (lessons, content) are resource-intensive
# Set to 0 to disable rate limiting for this job type
WORKER_RATE_LIMIT_GENERATION=3

# Worker Rate Limit: Rollup Jobs (jobs per minute)
# Production: 20 (max 20 rollup jobs per minute per worker)
# Rollup jobs are frequent but lightweight, so limit is higher
# Set to 0 to disable rate limiting for this job type
WORKER_RATE_LIMIT_ROLLUP=20

# =============================================================================
# DATABASE LOAD SAFETY: CONCURRENCY LIMITS
# =============================================================================
# Global concurrency limiter per process for DB calls
# Prevents connection pool exhaustion and database overload

# Supabase Max Concurrency: API Process
# Production: 5 (prevents connection pool exhaustion in API layer)
# Lower values provide stronger protection but may cause request queuing
# Higher values allow more parallelism but risk connection exhaustion
SUPABASE_MAX_CONCURRENCY=5

# Supabase Max Concurrency: Worker Process
# Production: 2 (prevents connection pool exhaustion in worker layer)
# Workers process jobs sequentially, so lower concurrency is safe
# Must be <= MAX_DB_CONNECTIONS to prevent connection pool exhaustion
SUPABASE_MAX_CONCURRENCY_WORKER=2

# Batch Parallelization Concurrency Multipliers
# These control how many items can be processed concurrently in batch operations
# Multipliers are applied to MAX_DB_CONNECTIONS to calculate max concurrency
# Production: 1.5-2.0 (balances throughput vs connection pool usage)
# Higher values increase throughput but risk connection pool exhaustion
BATCH_MASTERY_UPDATE_CONCURRENCY_MULTIPLIER=2.0
BATCH_CONCEPT_PROCESSING_CONCURRENCY_MULTIPLIER=2.0
BATCH_DEFAULT_CONCURRENCY_MULTIPLIER=1.5

# =============================================================================
# WORKLOAD ISOLATION: JOB-TYPE SPECIFIC CONCURRENCY LIMITS
# =============================================================================
# Job-type specific concurrency limits prevent long-running jobs from starving
# shorter jobs and protect against AI provider rate limit exhaustion.
# Each job type has its own concurrency limit based on resource usage patterns.

# Tutor Chat Concurrency Limit
# Production: 2 (long-running, multiple LLM calls, ~30s duration)
# Prevents tutor jobs from consuming all worker capacity
JOB_CONCURRENCY_TUTOR_CHAT=2

# Answer Grading Concurrency Limit
# Production: 4 (shorter duration, ~3.5s, single LLM call)
# Allows more concurrent grading jobs for faster turnaround
JOB_CONCURRENCY_GRADE_ANSWER=4

# Mock Exam Grading Concurrency Limit
# Production: 1 (very long-running, ~90s, high token usage)
# Very conservative limit to prevent resource exhaustion
JOB_CONCURRENCY_GRADE_MOCK_EXAM=1

# Concept Explanation Concurrency Limit
# Production: 5 (fastest job, ~2s, single LLM call, low tokens)
# Highest concurrency for fastest turnaround
JOB_CONCURRENCY_EXPLAIN_CONCEPT=5

# Lesson Creation Concurrency Limit
# Production: 3 (medium duration, ~20s, single LLM call)
# Balanced concurrency for lesson generation
JOB_CONCURRENCY_CREATE_LESSON=3

# =============================================================================
# AI PROVIDER RATE LIMIT PROTECTION
# =============================================================================
# Protects against OpenAI rate limit exhaustion by tracking requests and tokens.
# These limits should match your OpenAI plan limits.

# OpenAI Rate Limit: Requests Per Minute (RPM)
# Production: 500 (adjust based on your OpenAI plan)
# Prevents exceeding OpenAI's request rate limits
OPENAI_RATE_LIMIT_RPM=500

# OpenAI Rate Limit: Tokens Per Minute (TPM)
# Production: 200000 (adjust based on your OpenAI plan)
# Prevents exceeding OpenAI's token rate limits
OPENAI_RATE_LIMIT_TPM=200000

# =============================================================================
# JOB STARVATION PREVENTION
# =============================================================================
# Prevents short jobs from being starved by long-running jobs.

# Short Job Maximum Wait Time (seconds)
# Production: 30 (short jobs get priority boost after 30s wait)
# Prevents short jobs from waiting indefinitely behind long jobs
SHORT_JOB_MAX_WAIT_SECONDS=30

# Short Job Duration Threshold (seconds)
# Production: 5 (jobs with duration < 5s are considered "short")
# Used to identify jobs eligible for starvation prevention
SHORT_JOB_DURATION_THRESHOLD=5

# Worker Poll Timeout: How long worker waits for new jobs before checking again (seconds)
# Production: 5 (balances responsiveness vs CPU usage)
# Lower values increase CPU usage but improve job pickup latency
# Higher values reduce CPU but increase job wait time
WORKER_POLL_TIMEOUT=5

# Health Monitoring and Graceful Degradation
# Health Check Interval: How often to check worker health (seconds)
# Production: 30 (every 30 seconds) - monitors worker state and applies degradation if needed
HEALTH_CHECK_INTERVAL=30

# Worker Health Reporting (Lightweight, Passive)
# Worker Health TTL: How long worker health reports are valid (seconds)
# Production: 60 (1 minute) - workers must update within this time or be considered dead
# Workers update every WORKER_HEALTH_UPDATE_INTERVAL seconds
WORKER_HEALTH_TTL=60

# Worker Health Update Interval: How often workers report their health (seconds)
# Production: 30 (every 30 seconds) - balances freshness vs Redis load
# Health reporting is lightweight and non-blocking
WORKER_HEALTH_UPDATE_INTERVAL=30

# Maximum Consecutive Failures: Failures before entering degradation mode
# Production: 10 (conservative threshold) - prevents premature degradation
# Triggers graceful degradation to protect system under sustained failure conditions
MAX_CONSECUTIVE_FAILURES=10

# Circuit Breaker Reset Time: Time before circuit breaker resets (seconds)
# Production: 300 (5 minutes) - allows system to recover before retrying
# Circuit breaker prevents overwhelming system during outages
CIRCUIT_BREAKER_RESET_TIME=300

# Enable Graceful Degradation: Enable graceful degradation under pressure (boolean)
# Production: true (reduces activity under pressure to protect system)
# Workers slow down processing when consecutive failures exceed threshold
ENABLE_GRACEFUL_DEGRADATION=true

# Degradation Mode Threshold: Consecutive failures to trigger degradation
# Production: 5 (conservative) - triggers degradation early to prevent overload
# Lower values trigger degradation sooner (more protective, less throughput)
DEGRADATION_MODE_THRESHOLD=5

# =============================================================================
# DATABASE OPTIMIZATION: CACHING
# =============================================================================
# Read-through caching reduces database load for frequently accessed data.
# These TTLs balance freshness vs database load.

# Database Cache TTL: Default TTL for cached database queries (seconds)
# Used by db_cache service for general query caching
# Production: 300 (5 minutes) - balances freshness vs load
DB_CACHE_TTL=300

# Maximum Cache Size: Maximum entries in in-memory LRU cache
# Limits memory usage per worker for local cache layer
# Production: 1000 (sufficient for hot data, manageable memory)
MAX_CACHE_SIZE=1000

# Read-Through Cache TTLs: Specific TTLs for different data types (seconds)
# These are used by read_cache service for structured caching
DEFAULT_CACHE_TTL=3600
CACHE_TTL_STATIC=86400
CACHE_TTL_SEMI_STATIC=3600
CACHE_TTL_FREQUENT=300
CACHE_TTL_USER=1800
CACHE_TTL_QUERY=600

# Deterministic Operation Cache TTLs: TTLs for deterministic, side-effect-free operations (seconds)
# These are used by deterministic_cache service for AI operation caching
# Readiness assessment: Deterministic over short time windows, invalidated on mastery updates
# Production: 900 (15 minutes) - balances freshness vs performance
# Cache keys include user_id and concept_ids for proper scoping
CACHE_TTL_READINESS_ASSESSMENT=900

# =============================================================================
# EMBEDDING PRE-GENERATION CONFIGURATION
# =============================================================================
# Pre-generates embeddings for high-traffic topics/concepts to reduce latency.
# Background job runs periodically to identify and pre-generate embeddings.

# Enable Embedding Pre-generation: Enable background pre-generation (boolean)
# Production: true (reduces embedding generation latency for common queries)
# Disable if you want to generate embeddings only on-demand
ENABLE_EMBEDDING_PREGEN=true

# Pre-generation Interval: How often to run background pre-generation (seconds)
# Production: 3600 (1 hour) - balances freshness vs resource usage
# Lower values keep embeddings more up-to-date but increase API calls
EMBEDDING_PREGEN_INTERVAL_SECONDS=3600

# Pre-generation Batch Size: Maximum embeddings to generate per run
# Production: 50 (balances progress vs API rate limits)
# Higher values generate more embeddings per run but may hit rate limits
EMBEDDING_PREGEN_BATCH_SIZE=50

# Pre-generation Rate Limit Delay: Delay between embedding generations (seconds)
# Production: 0.1 (100ms = 10 embeddings/second) - respects OpenAI rate limits
# Lower values generate faster but risk hitting rate limits
EMBEDDING_PREGEN_RATE_LIMIT_DELAY=0.1

# Pre-generated Embedding Cache TTL: How long pre-generated embeddings are cached (seconds)
# Production: 604800 (7 days) - embeddings are versioned and invalidated on content changes
# Longer TTL reduces regeneration but uses more cache memory
EMBEDDING_PREGEN_CACHE_TTL=604800

# Embedding Usage Tracking Window: Time window for tracking embedding usage (hours)
# Production: 24 (24 hours) - identifies high-traffic topics/concepts over last day
# Longer windows capture more usage patterns but use more Redis memory
EMBEDDING_TRACKING_WINDOW_HOURS=24

# Minimum Access Count: Minimum accesses to be considered "high-traffic"
# Production: 10 (topics/concepts accessed 10+ times in tracking window)
# Lower values pre-generate more embeddings but may include less popular items
EMBEDDING_MIN_ACCESS_COUNT=10

# =============================================================================
# STREAMING CONFIGURATION
# =============================================================================
# Enables incremental delivery of long-running AI responses via Server-Sent Events (SSE).
# Maintains Redis-first architecture and job isolation while providing real-time updates.

# Enable Streaming: Enable streaming for long-running AI responses (boolean)
# Production: true (provides better UX with incremental delivery)
# Disable if you prefer polling-only approach
STREAMING_ENABLED=true

# Stream Chunk TTL: How long streaming chunks are stored in Redis (seconds)
# Production: 3600 (1 hour) - allows replay/recovery of chunks
# Longer TTL allows clients to reconnect and replay missed chunks
# Shorter TTL reduces Redis memory usage
STREAM_CHUNK_TTL=3600

# Stream Timeout: Maximum streaming duration for SSE connections (seconds)
# Production: 300 (5 minutes) - prevents indefinite connections
# Clients can reconnect if needed, or fall back to polling
# Range: 10-600 seconds (enforced by API endpoint)
STREAM_TIMEOUT=300

# =============================================================================
# DATABASE OPTIMIZATION: BATCHED WRITES
# =============================================================================
# Batched writes reduce database I/O spikes by accumulating writes and flushing periodically.
# Critical for maintaining database stability under load.

# Batch Size: Number of writes to accumulate before flushing
# Production: 50-100 (balances latency vs I/O efficiency)
# Larger batches = fewer DB calls but higher write latency
DB_BATCH_SIZE=50

# Batch Interval: Time between periodic batch flushes (seconds)
# Production: 2.0 (balances latency vs batching efficiency)
# Lower values reduce write latency but increase DB calls
DB_BATCH_INTERVAL=2.0

# Maximum Batch Wait: Maximum time to wait before flushing incomplete batch (seconds)
# Production: 5.0 (prevents indefinite batching, ensures timely writes)
# Prevents small batches from waiting too long
MAX_BATCH_WAIT=5.0

# =============================================================================
# RATE LIMITING CONFIGURATION (PERMANENT ENFORCEMENT)
# =============================================================================
# Rate limits are PERMANENTLY ENFORCED - no toggles, no overrides, no fail-open behavior
# Limits are strict to prevent abuse, accidental loops, and infrastructure overload
# Still allow normal usage patterns but prevent excessive requests
# Rate limiting is integrated with queue back-pressure to prevent uncontrolled job growth
# Per-user rate limiting based on authenticated user identity (no anonymous users allowed)
# Limits are enforced per authenticated user (not IP) and vary by AI work category
# All limits are "requests per window" where window is typically 1 hour (3600 seconds)

# Tutor Chat Rate Limits (STRICT: prevents loops)
# Category: Conversational AI tutoring
# Production: 60/hour (strict limit to prevent accidental loops and abuse)
# Lower values provide stronger protection against loops and infrastructure overload
# Still allows normal usage: ~1 request per minute average
RATE_LIMIT_TUTOR_CHAT_REQUESTS=60
RATE_LIMIT_TUTOR_CHAT_WINDOW=3600

# Answer Grading Rate Limits (STRICT: prevents batch abuse)
# Category: Single answer grading
# Production: 100/hour (strict limit to prevent batch processing abuse)
# Prevents users from submitting hundreds of answers simultaneously
# Still allows normal usage: ~1.7 requests per minute average
RATE_LIMIT_ANSWER_GRADING_REQUESTS=100
RATE_LIMIT_ANSWER_GRADING_WINDOW=3600

# Mock Exam Grading Rate Limits (STRICT: prevents exam spam)
# Category: Complete exam grading (more expensive operation)
# Production: 10/hour (strict limit to prevent exam spam and resource exhaustion)
# Mock exams are resource-intensive, so limits are conservative
# Still allows normal usage: ~1 exam every 6 minutes
RATE_LIMIT_MOCK_EXAM_GRADING_REQUESTS=10
RATE_LIMIT_MOCK_EXAM_GRADING_WINDOW=3600

# Concept Explanation Rate Limits (STRICT: prevents query spam)
# Category: Helping agent concept explanations (lightweight)
# Production: 200/hour (strict limit to prevent query spam)
# Prevents users from submitting hundreds of explanation requests
# Still allows normal usage: ~3.3 requests per minute average
RATE_LIMIT_CONCEPT_EXPLANATION_REQUESTS=200
RATE_LIMIT_CONCEPT_EXPLANATION_WINDOW=3600

# Lesson Creation Rate Limits (STRICT: prevents generation spam)
# Category: AI-generated lesson content creation
# Production: 30/hour (strict limit to prevent generation spam)
# Lesson creation is resource-intensive, so limits are conservative
# Still allows normal usage: ~1 lesson every 2 minutes
RATE_LIMIT_LESSON_CREATION_REQUESTS=30
RATE_LIMIT_LESSON_CREATION_WINDOW=3600

# Global AI Work Rate Limit (STRICT: prevents overall abuse)
# Overall limit across all AI categories (prevents total abuse)
# Production: 500/hour (strict limit to prevent overall abuse)
# Prevents users from exhausting system resources across all categories
# Still allows normal usage: ~8.3 requests per minute average across all categories
RATE_LIMIT_ALL_AI_WORK_REQUESTS=500
RATE_LIMIT_ALL_AI_WORK_WINDOW=3600

# Rate Limiting Integration with Queue Back-Pressure
# When queue depth >= MAX_QUEUE_SIZE * QUEUE_BACK_PRESSURE_THRESHOLD (80%),
# effective rate limits are reduced by 50% to prevent uncontrolled job growth
# This ensures excessive demand does not translate into unbounded queue growth
# Example: If tutor chat limit is 60/hour, it becomes 30/hour when queue is under back-pressure

# =============================================================================
# FRONTEND CONFIGURATION (Client-Side)
# =============================================================================
# These variables are used by the frontend React application.
# They must be prefixed with VITE_ to be accessible in the browser.

# Dashboard Totals Refresh Interval: How often to refresh totals via API (seconds)
# Production: 90 (90 seconds) - refreshes study time, streaks, accuracy, etc.
# Range: 60-120 seconds (recommended)
# Uses normal API calls (not Realtime) to reduce WAL noise
# Realtime is only used for daily_analytics (low-frequency updates)
VITE_DASHBOARD_TOTALS_REFRESH_INTERVAL=90

# =============================================================================
# MEMORY SAFETY CONFIGURATION
# =============================================================================
# Memory safety settings for automatic restart and monitoring.
# These settings work with PM2 to restart processes when memory exceeds thresholds.
# Memory monitoring tracks peak memory usage and logs memory on every restart.

# Memory Threshold: Memory limit in MB (must match PM2 max_memory_restart)
# Production: 500-1000 (adjust based on available system memory)
# PM2 will automatically restart process if memory exceeds this threshold
# Lower values provide stronger protection but may cause frequent restarts
# Must match the max_memory_restart value in ecosystem.config.js
MEMORY_THRESHOLD_MB=500

# Enable Memory Monitoring: Enable memory usage tracking and logging (boolean)
# Production: true (enables memory logging and peak tracking)
# Disable if you don't want memory monitoring overhead
# Memory logs are written to logs/memory.log (JSONL format)
MEMORY_MONITORING_ENABLED=true

# Memory Check Interval: How often to check memory usage in worker loop (seconds)
# Production: 300 (5 minutes) - balances monitoring vs overhead
# Only applies to workers (backend doesn't have periodic checks)
# Lower values provide more frequent monitoring but increase overhead
# Set to 0 to disable periodic memory checks (startup/shutdown still logged)
# Workers will log memory warnings when usage exceeds 80% of threshold
MEMORY_CHECK_INTERVAL=300

# =============================================================================
# DEPRECATED / UNUSED CONFIGURATION
# =============================================================================
# The following variables are NOT used in the async Redis-first architecture:
# - REQUEST_TIMEOUT (API doesn't wait for AI execution)
# - MAX_CONCURRENT_REQUESTS (not applicable to async architecture)
# - DEBUG (use ENABLE_DEBUG instead)
# - GRADING_DEBUG (use ENABLE_DEBUG instead)
# - TUTOR_MODEL (handled by AI model configuration above)

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# 1. ENVIRONMENT=production
# 2. ENABLE_DEBUG=false
# 3. LOG_LEVEL=INFO or WARNING
# 4. ALLOWED_ORIGINS set to specific domains (not *)
# 5. REDIS_URL set (or REDIS_PASSWORD set for production Redis)
# 6. SUPABASE_SERVICE_ROLE_KEY set (if admin operations needed)
# 7. All rate limits reviewed and adjusted for expected load
# 8. MAX_QUEUE_SIZE adjusted based on Redis memory capacity
# 9. WORKER_CONCURRENCY and MAX_DB_CONNECTIONS aligned with resource limits
# 10. All sensitive keys stored securely (environment variables, secrets manager)
# 11. Model selection configured (HELPING_ENABLE_MODEL_SELECTION, HELPING_FAST_MODEL)
# 12. Streaming configuration reviewed (STREAMING_ENABLED, STREAM_CHUNK_TTL, STREAM_TIMEOUT)
